	partition Invoices = m
		mode: import
		source =
				let
				    Source = Invoices_Raw,
				    #"Merged Queries" = Table.NestedJoin(Source, {"InvoiceID"}, PaymentTotals, {"InvoiceID"}, "PaymentTotals", JoinKind.LeftOuter),
				    #"Expanded PaymentTotals" = Table.ExpandTableColumn(#"Merged Queries", "PaymentTotals", {"Received"}, {"Received"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded PaymentTotals",null,0,Replacer.ReplaceValue,{"Received"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Value",{{"Received", type number}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Outstanding", each Number.Round(List.Max({0, [GrossAmount] - [Received]}), 2)),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "DaysPastDue", each if [Outstanding] < 1 then null else Duration.Days(#date(2026, 3, 31) - [DueDate])),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "AgeBucket", each if [Outstanding] < 1 then "Paid"
				else if [DaysPastDue] <= 0 then "Not due"
				else if [DaysPastDue] <= 30 then "1-30"
				else if [DaysPastDue] <= 60 then "31-60"
				else if [DaysPastDue] <= 90 then "61-90"
				else "90+"),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "BucketOrder", each if [AgeBucket] = "Not due" then 1
				else if [AgeBucket] = "1-30" then 2
				else if [AgeBucket] = "31-60" then 3
				else if [AgeBucket] = "61-90" then 4
				else if [AgeBucket] = "90+" then 5
				else 6),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom3",{{"Outstanding", type number}, {"DaysPastDue", Int64.Type}, {"AgeBucket", type text}, {"BucketOrder", Int64.Type}})
				in
				    #"Changed Type1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

